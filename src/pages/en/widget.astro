---
import PageLayout from '../../layouts/PageLayout.astro';
import { SITE_URL } from '../../data/site-config';
import { route } from '../../i18n/routes';
import { breadcrumbSchema } from '../../lib/seo';
const lang = 'en';
const code = `<iframe src="${SITE_URL}/embed/what-am-i-entitled-to/" title="What am I entitled to: Italy’s ISEE and family bonuses" width="100%" height="1200" style="border:0;max-width:1100px" loading="lazy"></iframe>`;
---
<PageLayout title="Embed the “what am I entitled to” tool on your website" description="Embed the tool on Italy’s ISEE, child allowance and family bonuses for free with an iframe: one code to copy, no sign-up and no cookies, kept up to date with the rules." lang={lang} noindex={true} jsonLd={[breadcrumbSchema([{ name: 'Home', path: route('home', lang) }, { name: 'Widget', path: route('widget', lang) }])]} breadcrumbs={[{ label: 'Widget' }]} showAuthor={false}>
  <header class="mb-6">
    <h1 class="text-3xl font-bold text-navy-900 md:text-4xl">Embed the “what am I entitled to” tool</h1>
    <p class="mt-3 text-lg text-navy-700">One code to copy, no sign-up and no cost. Schools, family centres, parents’ associations and local media set it up in a minute.</p>
  </header>
  <div class="prose prose-slate max-w-none">
    <pre class="overflow-x-auto rounded-lg bg-navy-900 p-4 text-sm text-white"><code>{code}</code></pre>
    <p>Terms: the link under the tool stays visible, the tool is not altered and it comes with no warranty. When limits or amounts change, the tool is updated here and your page follows with no work on your side. Italian version: <code>{`${SITE_URL}/embed/a-cosa-ho-diritto/`}</code>.</p>
    <p>What your visitors type stays in their browser: nothing goes through our servers and the embedded frame sets no cookie on your site. For any request use the <a href={route('contact', lang)}>contact page</a>.</p>
  </div>
  <div class="mt-8 overflow-hidden rounded-xl border border-navy-200">
    <iframe src="/embed/what-am-i-entitled-to/" title="What am I entitled to: Italy’s ISEE and family bonuses" width="100%" height="1200" style="border:0" loading="lazy"></iframe>
  </div>
</PageLayout>
