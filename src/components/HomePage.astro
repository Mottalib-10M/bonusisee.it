---
/**
 * Accueil d'une langue (page pilier, RECETTE §5) : la question d'abord, « a cosa ho diritto ? », donc
 * l'outil qui additionne les mesures pour la famille ; puis le bloc citable replié, les dates à retenir,
 * les quatre rubriques et le texte. Texte dans src/content/home.ts.
 */
import PageLayout from '../layouts/PageLayout.astro';
import Outil from './Outil.astro';
import MiniSim from './calc/MiniSim';
import Clamp from './Clamp.astro';
import { HOME } from '../content/home';
import { route, type Locale } from '../i18n/routes';
import { navCategories } from '../i18n/nav';
import { helpers } from '../lib/helpers';
import { P } from '../lib/engine/params';
import type { SourceKey } from '../lib/engine/params';
import { AUTHOR_NAME } from '../data/site-config';
import { faqSchema, organizationSchema, websiteSchema, webPageSchema, webApplicationSchema } from '../lib/seo';
interface Props { lang: Locale }
const { lang } = Astro.props;
const x = HOME[lang];
const H = helpers(lang);
const path = route('home', lang);
const parts = x.body(H).split(/<!--mini:([A-Za-z0-9_]+)-->/);
const resume = x.resume(H);
const faqs = x.faqs(H);
const keys: SourceKey[] = ['inpsAuu', 'dpcm159', 'l199', 'dlgs230', 'inpsNido', 'inpsNuoviNati', 'inpsMamme', 'mefCarta2026', 'inpsAdi', 'ddl2027'];
const sources = keys.map((k) => ({ name: P.sources[k].label[lang], url: P.sources[k].url }));
const jsonLd = [websiteSchema(lang), organizationSchema(lang), webPageSchema({ name: x.h1, description: x.description, path, lang }), webApplicationSchema({ name: x.h1, description: x.description, path, lang }), faqSchema(faqs, lang)];
const it = lang === 'it';
const segna = [
  { d: P.date.mamme_domanda, t: it ? 'Domanda bonus mamme 2026' : 'Working-mothers bonus 2026 claim', id: 'bonus-mamme' },
  { d: P.date.dsu_2026_scade, t: it ? 'Scade l’ISEE 2026' : 'The 2026 ISEE expires', id: 'isee-2027' },
  { d: P.date.auu_annualita_2027, t: it ? 'Nuova annualità dell’assegno unico' : 'New child-allowance year', id: 'assegno-unico-2027' },
  { d: P.date.auu_arretrati_entro, t: it ? 'Ultimo giorno per rifare l’ISEE (la DSU) e avere gli arretrati da marzo' : 'Last day to renew the ISEE (the DSU form) and get arrears from March', id: 'assegno-unico-2027' },
];
const cats = navCategories(lang);
---
<PageLayout title={x.title} description={x.description} lang={lang} jsonLd={jsonLd} faqs={faqs} sources={sources}>
  <header class="mb-3">
    <h1 style="hyphens: manual" class="text-[1.75rem] font-bold text-navy-900 max-sm:leading-tight sm:text-3xl md:text-4xl">{x.h1}</h1>
    <p class="mt-2 text-base text-navy-700 max-sm:text-[0.95rem] sm:text-lg">{x.intro}</p>
  </header>
  <div data-outil><Outil tool="diritto" lang={lang} id="home" methodHref={route('method', lang)} /></div>
  <Clamp text={resume} lang={lang} id="clamp-home" sentences={2} class="mt-4" />
  <p class="mt-3 text-sm text-navy-600">{it ? 'Di' : 'By'} <a href={route('about', lang)} class="underline">{AUTHOR_NAME}</a> · <a href={route('method', lang)} class="underline">{it ? 'Metodo e fonti' : 'Method and sources'}</a> · <a href={route('calcolo-isee', lang)} class="underline">{it ? 'Calcola l’ISEE' : 'Estimate your ISEE'}</a></p>
  <section data-chrome class="mt-8 rounded-xl border border-navy-200 bg-navy-50 p-4 sm:p-6" aria-labelledby="segna">
    <h2 id="segna" class="text-lg font-bold text-navy-900">{it ? 'Le prossime date da segnare' : 'The next dates to note'}</h2>
    <ol class="mt-3 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
      {segna.map((s) => (
        <li class="rounded-lg bg-white p-3 shadow-sm">
          <p class="tabular-nums text-xl font-bold text-accent-700"><time datetime={s.d}>{H.date(s.d)}</time></p>
          <p class="mt-1 text-sm text-navy-700"><a href={route(s.id, lang)} class="hover:underline">{s.t}</a></p>
        </li>
      ))}
    </ol>
  </section>
  <nav data-chrome aria-label={it ? 'Argomenti' : 'Topics'} class="mt-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
    {cats.map((c) => (
      <div class="border-t-2 border-accent-500 pt-3">
        <p class="font-semibold text-navy-900">{c.label}</p>
        <ul class="mt-1 space-y-1 text-sm">{c.links.slice(0, 5).map((k) => <li><a href={k.href} class="text-accent-700 hover:underline">{k.label}</a></li>)}</ul>
      </div>
    ))}
  </nav>
  <div class="prose prose-slate mt-8 max-w-none">
    {parts.map((p, i) => i % 2 === 0 ? <Fragment set:html={p} /> : <div class="mini-bloc"><MiniSim client:load kind={p} lang={lang} href={route(p === 'mamme' ? 'bonus-mamme' : 'calcolo-isee', lang)} /></div>)}
  </div>
</PageLayout>
